{
  "name": "resume-screening-backend",
  "version": "1.0.0",
  "description": "Backend API server for Resume Screening & Candidate Ranking Web Application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --ignore uploads/ --ignore data/ server.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.5.2",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.4",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  },
  "nodemonConfig": {
    "ignore": [
      "data/**",
      "uploads/**"
    ],
    "ext": "js,mjs,cjs"
  }
}
